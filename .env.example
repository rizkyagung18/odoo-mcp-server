# Copy to .env and adjust. .env is gitignored, never commit real credentials.
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_demo
ODOO_USER=admin
# Password or, better, an Odoo API key (Preferences > Account Security > New API Key)
ODOO_PASSWORD=admin

# true = disable all write tools (create_lead is not even offered to the LLM).
# Recommended for anything except local experiments.
ODOO_READ_ONLY=false
